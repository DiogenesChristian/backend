# Porta da API
PORT=3001

# MongoDB (use local ou Atlas)
# Local: mongodb://127.0.0.1:27017/recordar
# Atlas: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/recordar
MONGO_URI=mongodb://127.0.0.1:27017/recordar

# JWT (use uma string longa e aleatória)
JWT_SECRET=()

# Usuário administrador criado automaticamente ao iniciar a API
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@recordar.com
ADMIN_SENHA=troque-esta-senha
